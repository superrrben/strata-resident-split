+    def forced_call(self, req, ids, forced, max_new):
+        """tool_choice (local patch): end the prompt inside the forced call and tell run() about it through the
+        request (its `sampling`), so nothing per-request is kept on the service.  -> (ids, max_new): the prefix
+        is part of the prompt, so the room prepare() worked out shrinks by its length."""
+        req.pop(FORCED_CALL_KEY, None)                  # only this server sets it: a client's value is dropped
+        if not forced:
+            return ids, max_new
+        req[FORCED_CALL_KEY] = forced
+        if not forced.endswith(">\n"):
+            # "required" with several tools: the model picks the name itself, and nothing constrains it to the
+            # listed ones.  Greedy it chose a listed tool 10 of 10 times; at temperature 1.0 it invented one
+            # ("lookup") 2 of 5 times.  So this request decodes greedy, whatever sampling it asked for.
+            req["temperature"] = 0
+        extra = self.tok.encode(forced, parse_special=True)
+        room = self.engine.max_context - CTX_SLACK - len(ids) - len(extra)
+        if room < 1:
+            raise ValueError(f"prompt ({len(ids)} tokens) + the forced tool call leaves no room to answer in the "
+                             f"context ({self.engine.max_context}); requests are never truncated")
+        return ids + extra, min(max_new, room)
+
