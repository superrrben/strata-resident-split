+# ------------------------------------------------------------------------------------------------ tool_choice
+def apply_tool_choice(choice, tools: list[dict] | None) -> tuple[list[dict] | None, str | None]:
+    """A request's "tool_choice" -> (the tools the template gets, the text the answer is made to start with).
+
+    Local patch (strata-resident-split): the field used to be ignored, so "none" still produced calls and a forced
+    call came back as plain text.  OpenAI: "auto" | "none" | "required" | {"type": "function", "function":
+    {"name": N}} (or {"type": "function", "name": N}).  Anthropic: {"type": "auto" | "none" | "any" | "tool",
+    "name": N}.
+      none      the tools are left out of the prompt, so the model cannot call one
+      required  the answer starts inside a call: `<tool_call>\n<function` (the template's format), and with one
+      / named   tool or a named one also its name - the model writes the rest.  There is no constrained
+                decoding: the arguments are the model's.  The caller renders the prompt without thinking.
+    ValueError (a 400) for a forced call without tools, an unknown name or an unknown value."""
+    if choice is None or choice == "auto" or (isinstance(choice, dict) and choice.get("type") == "auto"):
+        return tools, None
+    if choice == "none" or (isinstance(choice, dict) and choice.get("type") == "none"):
+        return None, None
+    name = None
+    if choice in ("required", "any") or (isinstance(choice, dict) and choice.get("type") in ("required", "any")):
+        pass
+    elif isinstance(choice, dict) and choice.get("type") in ("function", "tool"):
+        fn = choice.get("function") if isinstance(choice.get("function"), dict) else choice
+        name = fn.get("name")
+        if not isinstance(name, str) or not name:
+            raise ValueError("tool_choice names no function")
+    else:
+        raise ValueError(f"tool_choice={choice!r}: expected auto, none, required or a named function")
+    names = [t.get("name") for t in tools or [] if isinstance(t, dict)]
+    if not names:
+        raise ValueError("tool_choice forces a tool call, but the request has no tools")
+    if name is not None and name not in names:
+        raise ValueError(f"tool_choice names {name!r}, which is not one of the request's tools")
+    if name is None and len(names) == 1:
+        name = names[0]
+    # Unnamed: stop before the "=", because the tokenizer joins it to the name ("=get", "_weather"): a prompt
+    # ending in a lone "=" is a token sequence the model never wrote, and it then invented names ("web_search").
+    return tools, CALL_START + "\n<function" + ("=" + name + ">\n" if name else "")
+
+
